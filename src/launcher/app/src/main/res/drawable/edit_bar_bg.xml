<?xml version="1.0" encoding="utf-8"?>
<!--
  Frosted Material You-style background for the edit bar.
  Mostly-opaque themed surface with rounded bottom corners and a 1dp
  separator divider underneath for depth. The bar sits at the top of the
  screen, hugging the status-bar inset, so we round the BOTTOM corners only.
  Surface + separator both flip with the theme via values-night/colors.xml.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/edit_bar_surface"/>
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp"/>
        </shape>
    </item>
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/separator"/>
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</layer-list>
