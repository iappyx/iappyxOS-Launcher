<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.iappyxLauncher" parent="Theme.AppCompat.NoActionBar">
        <!-- Fully transparent system bars: wallpaper flows behind the clock /
             nav bar. windowTranslucent* is intentionally NOT set — those legacy
             flags make Android paint a default ~25% black scrim behind the bars. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- App drawer + settings: NO wallpaper pass-through, standard dark background.
         Both system bars tinted to bg_home so the full screen looks cohesive. -->
    <style name="Theme.iappyxLauncher.Opaque" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/bg_home</item>
        <item name="android:navigationBarColor">@color/bg_home</item>
        <item name="android:windowBackground">@color/bg_home</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- QUICK WIDGETS: panel activity. Translucent so the dimmed
         backdrop + centered panel render over whatever app the user
         was just in. Removable as a unit with the rest of QUICK WIDGETS. -->
    <style name="Theme.iappyxLauncher.QuickWidgetPanel" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- FIELD: translucent so the home page shows behind while the bubble
         organism morphs in from the on-screen icon positions. No window
         animation — the Field fades its own backdrop in instead. -->
    <style name="Theme.iappyxLauncher.FieldTranslucent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- BottomSheet theme with dark background, no white tint behind our content. -->
    <style name="Theme.iappyxLauncher.BottomSheet" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/iappyxBottomSheet</item>
        <item name="android:navigationBarColor">@color/bg_home</item>
    </style>
    <style name="iappyxBottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottomsheet_bg</item>
    </style>

    <!-- ============================================================ -->
    <!-- Type scale                                                  -->
    <!-- ============================================================ -->
    <!-- Type scale with variable weights for personality. -->
    <style name="TextTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextSection">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextLabel">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextHint">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <!-- ============================================================ -->
    <!-- Buttons                                                     -->
    <!-- ============================================================ -->
    <style name="Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/bg_home</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Button.Ghost" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <!-- Toolbar title appearance — used by settings_toolbar.xml. Sized to
         match the screen-body TextTitle (22sp) so the toolbar title and
         the menu-row label feel like the same word in the same place. -->
    <style name="TextAppearance.AppCompat.Widget.ActionBar.Title.Iappyx"
           parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Button.Danger" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Card container: rounded dark panel used to group related controls. -->
    <style name="Card">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
